# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

.playwright-screenshots/*
!.playwright-screenshots/.gitkeep

.playwright-mcp/*
!.playwright-mcp/.gitkeep

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# secretos sueltos
apiKEY.md

# supabase CLI (lo genera `supabase link`; guarda el ref y la pooler url del
# proyecto vinculado — nunca debe llegar a git)
supabase/.temp/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
