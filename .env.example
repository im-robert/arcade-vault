# Resend — envío del formulario de contacto (/acerca-de)
# Copia este archivo a .env.local y rellena RESEND_API_KEY con tu clave real.
# Estas variables son server-only: nunca se exponen al cliente.

# Secreto. Se obtiene en https://resend.com/api-keys — nunca lo subas al repo.
RESEND_API_KEY=

# Destinatario de los mensajes del formulario de contacto.
CONTACT_TO_EMAIL=capellan1603@gmail.com

# Remitente. Sandbox de Resend mientras no haya un dominio propio verificado.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Contraseña de la base del proyecto de DESARROLLO (swmezsmuwlavtbdtsstl).
# Solo para acceso directo a Postgres (CLI/migraciones), no la usa la app.
SUPABASE_DB_PASSWORD=XXX

# Contraseña de la base del proyecto de PRODUCCIÓN. Igual que la anterior,
# solo para CLI/migraciones — nunca se sube al hosting de la app.
SUPABASE_PROD_DB_PASSWORD=XXX

# Cliente de Supabase (browser/server/middleware). Se obtienen del dashboard
# de Supabase (Project Settings > API) o vía MCP get_project_url/get_publishable_keys.
# OJO: hay dos proyectos (dev y prod) con valores distintos. En .env.local
# van los de DESARROLLO; los de PRODUCCIÓN se configuran en las variables de
# entorno del hosting (Vercel u otro), nunca en este repo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=